{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "debug-viewer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "apps/debug-viewer",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "apps/web",
        "--port",
        "5181",
        "--strictPort"
